# syntax=docker/dockerfile:1.7
# Build stage — pure SPA build (Vite + TanStack Router)
FROM oven/bun:1 AS build-stage

WORKDIR /app

# Copy lockfile first to leverage Docker layer cache —
# this layer is reused unless package.json or bun.lockb changes
COPY package.json bun.lockb* ./

# Mount bun's cache directory so packages are reused across builds
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# Now copy the rest of the source code
COPY . .

# Build args (only the FastAPI backend URL is needed)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN bun run build

# Production stage — Nginx serving static dist/
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
