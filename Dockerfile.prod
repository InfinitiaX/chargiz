# Build stage — pure SPA build (Vite + TanStack Router)
FROM node:20-alpine AS build-stage

WORKDIR /app

COPY package.json package-lock.json* bun.lockb* ./

# Force dev mode so npm installs devDependencies (vite, typescript, etc.)
ENV NODE_ENV=development
RUN npm install

COPY . .

# Build args (only the FastAPI backend URL is needed)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Run vite directly via node — bypasses all PATH/symlink issues on Alpine
RUN node node_modules/vite/bin/vite.js build

# Production stage — Nginx serving static dist/
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
