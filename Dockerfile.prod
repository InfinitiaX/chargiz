# Build stage — pure SPA build (Vite + TanStack Router)
FROM node:20-alpine AS build-stage

WORKDIR /app

COPY package.json package-lock.json* bun.lockb* ./

# Force dev mode so npm installs devDependencies (vite, typescript, etc.)
ENV NODE_ENV=development
# Set network timeout and retries for flaky connections
# Install all dependencies including devDependencies (needed for vite)
RUN npm install --include=dev --network-timeout=100000
COPY . .

# Build args (needed at build time for Vite environment injection)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Run build using the script defined in package.json
RUN npm run build

# Production stage — Nginx serving static dist/
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
