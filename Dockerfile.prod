# Build stage — pure SPA build (Vite + TanStack Router)
FROM node:20-alpine AS build-stage

WORKDIR /app

COPY package.json package-lock.json* bun.lockb* ./

# Install ALL deps — force dev mode so vite/typescript are included
ENV NODE_ENV=development
RUN npm install

# Install vite globally as a guaranteed fallback
RUN npm install -g vite

COPY . .

# Build args (only the FastAPI backend URL is needed)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Use the global vite binary directly
RUN vite build

# Production stage — Nginx serving static dist/
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
