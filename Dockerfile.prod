# Build stage — pure SPA build (Vite + TanStack Router)
FROM node:20-alpine AS build-stage

WORKDIR /app

COPY package.json package-lock.json* bun.lockb* ./
# Install ALL deps (including devDependencies) so vite/tsc are available
RUN npm install --include=dev

COPY . .

# Build args (only the FastAPI backend URL is needed)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN ./node_modules/.bin/vite build

# Production stage — Nginx serving static dist/
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
